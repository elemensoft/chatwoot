# ========================================
# CONFIGURACIÓN CHATWOOT PRODUCCIÓN
# ========================================

SECRET_KEY_BASE=

# Active Record Encryption (Opcional - para MFA/2FA)
# Generar con: docker run --rm chatwoot/chatwoot:latest bundle exec rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
INSTALLATION_NAME=ElemenChat
# ========================================
# URLs Y DOMINIO
# ========================================
FRONTEND_URL=
FORCE_SSL=true

# ========================================
# REGISTRO DE NUEVAS CUENTAS
# ========================================
# false = Solo tú puedes crear cuentas (recomendado)
# true = Cualquiera puede registrarse
# api_only = Solo por API
ENABLE_ACCOUNT_SIGNUP=true

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_URL=
REDIS_PASSWORD=

# ========================================
# POSTGRESQL CONFIGURATION
# ========================================
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_STATEMENT_TIMEOUT=
RAILS_ENV=
RAILS_MAX_THREADS=

ACTION_CABLE_ALLOWED_REQUEST_ORIGINS=
# ========================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ========================================
# Remitente de emails
#MAILER_SENDER_EMAIL=Chatwoot <noreply@srv981175.hstgr.cloud>
#MAILER_SENDER_EMAIL=Chatwoot <noreply@chatwwot.elemensoft.com>
#MAILER_SENDER_EMAIL=noreply@chatwwot.elemensoft.com

# ========================================
# ALMACENAMIENTO
# ========================================
ACTIVE_STORAGE_SERVICE=local


# ========================================
# LOGS
# ========================================
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=
LOG_SIZE=

# ========================================
# APP MÓVIL
# ========================================
IOS_APP_ID=L7YLMN4634.com.chatwoot.app
ANDROID_BUNDLE_ID=
ANDROID_SHA256_CERT_FINGERPRINT=

# ========================================
# NOTIFICACIONES PUSH
# ========================================
ENABLE_PUSH_RELAY_SERVER=true
# Generar VAPID keys en: https://d3v.one/vapid-key-generator/
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ========================================
# SEGURIDAD Y RENDIMIENTO
# ========================================
# Rack Attack (protección contra abuso)
ENABLE_RACK_ATTACK=
RACK_ATTACK_LIMIT=

# Sidekiq concurrency
SIDEKIQ_CONCURRENCY=5


# SECCIÓN SMTP 
SMTP_ADDRESS=
SMTP_PORT=
#SMTP_PORT=
SMTP_DOMAIN=
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_TLS=
SMTP_SSL=
SMTP_OPENSSL_VERIFY_MODE=
SMTP_ENABLE_STARTTLS_AUTO=
# Email del remitente
MAILER_SENDER_EMAIL=
MAILER_NAME=
FRONTEND_URL=

# Facebook y Meta Cloud
#FB_APP_ID=
#FB_APP_SECRET=
#FB_CLIENT_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_CLIENT_TOKEN=
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=
ENABLE_FACEBOOK=
ENABLE_MESSENGER_CHANNEL_HUMAN_AGENT=

# Para que Rails sepa que debe usar Redis para los mensajes en vivo
REDIS_URL=
# Muy importante para las notificaciones en tiempo real
CABLE_URL=/cable
# Confianza total para el flujo interno
ACTION_CABLE_MOUNT_PATH=/cable
